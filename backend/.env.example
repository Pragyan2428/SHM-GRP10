# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core (required) ---
MONGO_URL=mongodb://localhost:27017
# MONGO_URL=mongomock://            # in-memory DB for demos/tests (data lost on restart)
DB_NAME=shm_command_center
# >= 32 random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# explicit CORS origin(s), comma-separated
FRONTEND_URL=http://localhost:5173
# set false only for plain-http local development
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
STRUCTURE_NAME=Academic Block A (G+3 building)

# --- Bootstrap administrator (used only when the users collection is empty) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator
# true = on the next start, ADMIN_EMAIL becomes an admin with exactly ADMIN_PASSWORD (forgotten password, new admin
# email, or a locked-out admin). Turn it off again after logging in, or the password is reset on every start.
ADMIN_RESET=false
# Optional demo viewer
SEED_VIEWER_EMAIL=
SEED_VIEWER_PASSWORD=

# --- Self-service sign-up (Sign up page; always creates viewer accounts) ---
ALLOW_SIGNUP=true
# Only this email domain may sign up (name@gmail.com); admins and seeded accounts are not affected
SIGNUP_EMAIL_DOMAIN=gmail.com

# --- Login protection ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCKOUT_MINUTES=15

# --- Telemetry ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=5
NODE_OFFLINE_SECONDS=30
READING_RETENTION_DAYS=30

# --- ESP32 device authentication (X-Device-Key header) ---
DEVICE_SHARED_KEY=
# Per-device keys override the shared key: ESP32-01:key1,ESP32-02:key2
DEVICE_KEYS=

# --- Email (smtp | resend | sendgrid) ---
# Gmail: EMAIL_PROVIDER=smtp, SMTP_USERNAME=your Gmail, SMTP_PASSWORD=16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords). Never your normal password.
EMAIL_PROVIDER=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# resend / sendgrid only
EMAIL_API_KEY=

# --- SMS and WhatsApp (twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS: set SMS_PROVIDER=twilio and a Twilio phone number
SMS_PROVIDER=
TWILIO_FROM_NUMBER=
# WhatsApp: Twilio sandbox number +14155238886 (recipients first send "join <code>" to it), or your approved sender
TWILIO_WHATSAPP_FROM=

# --- Google Sheets (service account; share the sheet with its client_email) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET=SHM Alerts
# No-key option: Apps Script web app bound to the sheet (code: backend/app/static/sheets_apps_script.gs).
# Set both to use it; it takes priority over the service account.
GOOGLE_SHEETS_WEBHOOK_URL=
# >= 16 random chars, also saved as SHM_SECRET in the Apps Script project properties
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- MQTT (disabled when MQTT_BROKER_URL is empty) ---
MQTT_BROKER_URL=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=shm/+/telemetry
MQTT_TLS=false
